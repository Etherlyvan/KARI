{
  "name": "kari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable KARI companion widget and private AI gateway",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "build:api": "tsc -p tsconfig.api.json",
    "build:widget": "vite build --config vite.config.ts && node scripts/copy-assets.mjs",
    "build": "npm run build:api && npm run build:widget",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "jsdom": "26.1.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
