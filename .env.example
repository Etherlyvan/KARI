# Public sites: register the EXACT browser origin and a public ID, never a browser API key.
HOST=0.0.0.0
PORT=3000
KARI_SITES_JSON='[{"id":"portfolio","name":"Jovan portfolio","origins":["http://localhost:3000","http://127.0.0.1:3000","http://localhost:4321","http://127.0.0.1:4321","http://localhost:8080","http://127.0.0.1:8080"],"knowledgePath":"data/portfolio.json"}]'
DEMO_ENABLED=true

# Optional locally; required for durable notes, reminders and any paid inference.
# DATABASE_URL=postgresql://kari_app:YOUR_RUNTIME_DATABASE_PASSWORD@127.0.0.1:5432/kari
# Local db:migrate requires a separately supplied admin DATABASE_URL; do not run it as kari_app.

AI_ENABLED=false
AI_CAPABILITIES_VERIFIED=false
AI_BASE_URL=https://ai.yogathedev.com/v1
AI_DEFAULT_MODEL=deepseek-v4-flash
AI_API_KEY=

# Off until a verified private owner, bot and webhook secret are configured.
TELEGRAM_ENABLED=false
TELEGRAM_OWNER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Compose only: two DIFFERENT 24-128 character URL-safe passwords ([A-Za-z0-9_-]).
# POSTGRES_PASSWORD is admin-only; KARI_DB_PASSWORD is the restricted runtime role.
# Values are used raw in connection URIs, so punctuation outside that set is not accepted.
POSTGRES_PASSWORD=
KARI_DB_PASSWORD=
# Explicit trusted proxy IP/CIDR only, never '*'. Empty by default.
KARI_TRUSTED_PROXIES=
